# Reserved configuration proposal for upcoming runtime/session stories.
# The health-only bootstrap does not load these settings yet.
# Copy to .env when their implementation lands. Never commit real values.
APP_ENV=development
APP_BIND_HOST=127.0.0.1
APP_PORT=8000
APP_ALLOWED_ORIGIN=http://127.0.0.1:5173
APP_SESSION_SECRET=
# Absolute private directory OUTSIDE the repository and OneDrive.
APP_RUNTIME_DIR=
SCAN_POLICY_ID=safety-v1
# External AI stays disabled unless configured AND the submission opts in.
MODEL_ENABLED=false
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=

# Optional HTTPS JSON explanation adapter; disabled by default. No live provider needed.
VIBEGUARD_AI_ENABLED=0
VIBEGUARD_AI_ENDPOINT=
VIBEGUARD_AI_TOKEN=
