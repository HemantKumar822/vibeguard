# Copy to .env. Load in BOTH API and coordinator with uv run --env-file .env.
# Never commit .env or put the API key in frontend/VITE_ variables.
# Set VIBEGUARD_RUNTIME_DIR outside the checkout/OneDrive in both terminals.
VIBEGUARD_ORIGIN=http://127.0.0.1:5173
VIBEGUARD_LOOPBACK_HTTP=1

# Groq is contacted only when configured AND the submission opts in.
# Without a key, deterministic reports and repair prompts still work.
VIBEGUARD_AI_ENABLED=1
VIBEGUARD_AI_PROVIDER=groq
VIBEGUARD_AI_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# Optional legacy JSON adapter: set provider=custom and configure these.
VIBEGUARD_AI_ENDPOINT=
VIBEGUARD_AI_TOKEN=
