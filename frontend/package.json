{
  "name": "vibeguard-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-production.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "generate:types": "openapi-typescript ../contracts/openapi.json -o src/generated/api.ts",
    "typecheck": "tsc -b",
    "test": "vitest run --environment jsdom",
    "check:contracts": "node scripts/check-contracts.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.88.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.19 <25"
  }
}
